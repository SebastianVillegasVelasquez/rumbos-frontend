# Base URL the browser calls. In development the Vite proxy serves /api.
VITE_API_BASE_URL=/api

# Where the Vite dev proxy forwards /api/* (the /api prefix is stripped).
VITE_API_PROXY_TARGET=http://localhost:8000

# How a student opens a Moodle activity: "tab" (new window, default) or "modal" (iframe).
VITE_ACTIVITY_OPEN_MODE=tab

# "true" serves an in-memory mock instead of the backend, for demos without a server.
VITE_USE_MOCK_API=false
