# Base URL the browser calls (no trailing slash). Request paths such as /course-maps are appended to it.
VITE_API_BASE_URL=/api/v1

# Where the Vite dev proxy forwards /api/* (the prefix is kept, so the backend sees /api/v1/...).
VITE_API_PROXY_TARGET=http://localhost:8000

# How a student opens a Moodle activity: "tab" (new window, default) or "modal" (iframe).
VITE_ACTIVITY_OPEN_MODE=tab

# Whether the background picker offers the bundled demo backgrounds ("Predefinidos").
# Defaults to true in development and false in production builds, because the
# bundled art has no verified license. Set to "true"/"false" to override.
# VITE_SHOW_BUNDLED_BACKGROUNDS=false

# "true" serves an in-memory mock instead of the backend, for demos without a server.
VITE_USE_MOCK_API=false
